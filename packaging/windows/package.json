{
  "name": "storybridge-studio-windows",
  "version": "1.0.0",
  "description": "StoryBridge Studio Windows Debug Portable Wrapper",
  "author": "StoryBridge Studio",
  "main": "main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron .",
    "pack:debug": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.storybridge.studio.debug",
    "productName": "StoryBridge Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json",
      "dist-web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "StoryBridge-Studio-Debug.exe"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
